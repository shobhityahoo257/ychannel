# You need ONE key for scripting/photo-picking (Anthropic or OpenAI)
# and ONE for the voice (ElevenLabs or OpenAI). OpenAI alone covers everything.
OPENAI_API_KEY=
OPENAI_VOICE=onyx

ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Optional: more photo sources for the photo scout (free keys; Wikimedia Commons and Openverse need none)
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Optional: approval via Telegram (create a bot with @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# YouTube OAuth client file (Google Cloud Console -> OAuth client ID -> Desktop app)
YOUTUBE_CLIENT_SECRETS=secrets/client_secret.json
